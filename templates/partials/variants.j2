{%- if component_config.category == 'navigation' %}
      variant: {
        default: "bg-blue-600 text-white hover:bg-blue-700 bg-primary-600 text-white hover:bg-primary-700",
        destructive: "bg-red-600 text-white hover:bg-red-700 bg-error-600 text-white hover:bg-error-700",
        outline: "border border-gray-300 bg-white hover:bg-gray-50",
        secondary: "bg-gray-100 text-gray-900 hover:bg-gray-200",
        ghost: "hover:bg-gray-100",
        link: "underline-offset-4 hover:underline text-blue-600 text-primary-600",
        primary: "bg-blue-600 text-white hover:bg-blue-700 bg-primary-600 text-white hover:bg-primary-700",
        success: "bg-green-600 text-white hover:bg-green-700 bg-success-500 text-white hover:bg-success-600",
        warning: "bg-yellow-500 text-white hover:bg-yellow-600 bg-warning-500 text-white hover:bg-warning-600",
      },
      size: {
        default: "h-10 py-2 px-4",
        sm: "h-9 px-3 rounded-md",
        md: "h-10 py-2 px-4",
        lg: "h-11 px-8 rounded-md",
        icon: "h-10 w-10",
      }
{%- elif component_config.category == 'forms' %}
      variant: {
        default: "border-gray-300 bg-white",
        error: "border-red-500 bg-red-50 border-error-500 bg-error-50",
        success: "border-green-500 bg-green-50 border-success-500 bg-success-50",
        warning: "border-yellow-500 bg-yellow-50 border-warning-500 bg-warning-50",
      },
      size: {
        sm: "h-9 px-3 text-sm",
        md: "h-10 px-3 text-sm",
        lg: "h-11 px-4 text-base",
      }
{%- elif component_config.category == 'display' %}
      variant: {
        default: "bg-white border-gray-200",
        elevated: "bg-white border-gray-200 shadow-md",
        outlined: "bg-white border-gray-300",
        filled: "bg-gray-50 border-gray-200",
        success: "bg-green-50 border-green-200 bg-success-50 border-success-200",
        warning: "bg-yellow-50 border-yellow-200 bg-warning-50 border-warning-200",
        error: "bg-red-50 border-red-200 bg-error-50 border-error-200",
        ghost: "bg-transparent border-transparent shadow-none",
      },
      size: {
        sm: "p-4",
        md: "p-6",
        lg: "p-8",
        xl: "p-10",
      },
      layout: {
        default: "flex flex-col",
        horizontal: "flex flex-row gap-6",
        stacked: "flex flex-col gap-2",
        grid: "grid grid-cols-1 gap-4",
      }
{%- elif component_config.category == 'feedback' %}
      variant: {
        default: "bg-white border-gray-200 text-gray-950",
        destructive: "bg-red-50 border-red-200 text-red-800 bg-error-50 border-error-200 text-error-800",
        outline: "bg-white border-gray-300 text-gray-950",
        secondary: "bg-gray-50 border-gray-200 text-gray-800",
        ghost: "bg-transparent border-transparent text-gray-950",
        link: "bg-transparent border-transparent text-blue-600 text-primary-600 underline",
        info: "bg-blue-50 border-blue-200 text-blue-800 bg-primary-50 border-primary-200 text-primary-800",
        success: "bg-green-50 border-green-200 text-green-800 bg-success-50 border-success-200 text-success-800",
        warning: "bg-yellow-50 border-yellow-200 text-yellow-800 bg-warning-50 border-warning-200 text-warning-800",
        error: "bg-red-50 border-red-200 text-red-800 bg-error-50 border-error-200 text-error-800"
      },
      size: {
        sm: "p-3 text-sm",
        md: "p-4 text-sm",
        lg: "p-6 text-base"
      },
      dismissible: {
        true: "pr-12",
        false: ""
      }
{%- endif %}