  {
    {%- include 'partials/variants_figma.j2' %}
  }
)
{%- elif component_config.category == 'forms' %}
// Form input variants using CVA with Figma design tokens
const {{ component_config.name|lower }}Variants = cva(
  // Base classes
  "flex {{ design_vars.component_defaults.input.border_radius|join(' ') if design_vars.component_defaults.input.border_radius else 'rounded-md' }} w-full text-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50",
  {
    {%- include 'partials/variants_figma.j2' %}
  }
)
{%- elif component_config.category == 'display' %}
// Display component variants using CVA with Figma design tokens
const {{ component_config.name|lower }}Variants = cva(
  // Base classes
  "{{ design_vars.component_defaults.card.background|join(' ') if design_vars.component_defaults.card.background else 'bg-white' }} {{ design_vars.component_defaults.card.border_color|join(' ') if design_vars.component_defaults.card.border_color else 'border-gray-200' }} border {{ design_vars.component_defaults.card.shadow|join(' ') if design_vars.component_defaults.card.shadow else 'shadow' }} {{ design_vars.component_defaults.card.border_radius|join(' ') if design_vars.component_defaults.card.border_radius else 'rounded-lg' }}",
  {
    {%- include 'partials/variants_figma.j2' %}
  }
)
{%- elif component_config.category == 'feedback' %}
// Feedback component variants using CVA with Figma design tokens
const {{ component_config.name|lower }}Variants = cva(
  // Base classes
  "{{ design_vars.component_defaults.card.background|join(' ') if design_vars.component_defaults.card.background else 'bg-white' }} {{ design_vars.component_defaults.card.border_color|join(' ') if design_vars.component_defaults.card.border_color else 'border-gray-200' }} border w-full",
  {
    {%- include 'partials/variants_figma.j2' %}
  }
)
{%- endif %}

